{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "drop",
  "version": "0.1.0",
  "identifier": "dev.memolabs.drop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "resources": {
      "resources/node": "node",
      "resources/drop.mjs": "drop.mjs",
      "resources/drop-mcp.mjs": "drop-mcp.mjs"
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["drop"]
      }
    }
  }
}
