{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["es2023", "dom", "dom.iterable"]
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/coverage",
    "openspec",
    ".claude",
    ".agents",
    "docs/demo/julie-repo",
    "apps/mac/src-tauri/target",
    "crates/*/target",
    "apps/mac/src-tauri/gen",
    "apps/mac/src-tauri/resources"
  ]
}
